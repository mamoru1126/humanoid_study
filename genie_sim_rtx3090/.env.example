# cp .env.example .env して編集する（スクリプトが .env を読み込む. なければ自動でコピーされる）
# 書式は「名前=値」. bash として読み込むので、= の前後に空白を入れないこと.

# ---- 置き場所 ----------------------------------------------------------------
# Genie Sim の本体、アセット、Python の仮想環境、Isaac Sim のキャッシュをここに置く.
# 目安: 本体 約 1 GB、アセット 約 7 GB、キャッシュ 数 GB. 空きの多いディスクにする.
GS_WORKDIR=$HOME/genie_sim_ws

# ---- Genie Sim の本体 ----------------------------------------------------------
GENIESIM_REPO_URL=https://github.com/AgibotTech/genie_sim.git
# 手順を確かめた版に固定している（2026-11-13 の版. VERSION は 3.6.0、Isaac Sim 6.2 向け）.
# 最新を使うときは main にする. その場合、手順やオプションが変わっていることがある.
GENIESIM_REF=083793f238762d336ce8570d22118a60a6830875

# ---- アセット（シーン、物体、ロボットのモデル）-----------------------------------
# 取得するタスクの組. 空白で区切って複数書ける.
#   g2op_if                     指示理解の 10 タスク（約 6.4 GiB）. 最初はこれだけでよい
#   manip spatial               操作、空間理解
#   g2op_if_pick_block_color    タスク1つだけ（約 5.1 GiB. 背景画像が共通なので、あまり減らない）
ASSET_SELECTORS=g2op_if
# 取得元. huggingface か modelscope. 中身は同じ
ASSET_SOURCE=huggingface
# 同時にダウンロードする数（1〜32）
ASSET_WORKERS=8

# ---- Docker イメージ -----------------------------------------------------------
# pull  : 公開されているビルド済みイメージを取得する（既定. 早い）
# build : 手元でビルドする（1 時間以上かかることがある）
IMAGE_MODE=pull
PREBUILT_IMAGE=yonhdee/genie_sim:geniesim4
# Genie Sim の CLI が使うイメージ名とコンテナ名（変えなくてよい）
GS_IMAGE=registry.agibot.com/genie-sim/geniesim4:latest
GS_CONTAINER=geniesim4
# build のときだけ使う. libuipc（布などの変形物体のソルバ）の対応 GPU は 89（RTX 40 系）か 120（RTX 50 系）.
# RTX 3090 は 86 で対象外のため、指定しないとビルドが止まる. 89 を入れてビルドだけ通す
# （3090 では libuipc を使うタスクは動かない. それ以外のタスクには影響しない）.
LIBUIPC_SM=89

# ---- 起動 ----------------------------------------------------------------------
# コンテナに画面（X11）をつなぐか.
#   auto  : DISPLAY があればつなぐ（既定）
#   true  : つなぐ
#   false : つながない（SSH 越しや、画面のない PC）
CONTAINER_GUI=auto
# コンテナの準備ができるまで待つ秒数の上限
UP_TIMEOUT=900

# ---- 動作確認 ------------------------------------------------------------------
# 確認に使うタスクと、シーンの番号（0 から. カンマで区切って複数書ける）
SMOKE_TASK=g2op_if_pick_block_color
SMOKE_INSTANCE_IDS=0
# 実行のときに Isaac Sim の画面を開くか. true にするには、画面をつないだコンテナが要る.
# false でも、カメラ画像の保存と録画で様子を確かめられる
RUN_WINDOW=false

# 評価のコマンド（geniesim benchmark run）に足す設定. 「--名前=値」を空白で区切って書く. ふだんは空でよい.
# 例: 描画の準備が長く、Genie Sim の「300 秒進まなければ打ち切る」仕組みにかかるとき
#   EXTRA_ARGS="--app.main_loop_stall_timeout_s=900"
EXTRA_ARGS=

# ---- 方策（policy）サーバ --------------------------------------------------------
# 09_run_hold.sh と hold_server.sh が「動かない方策」を立てるポート（コンテナはホストのネットワークを使う）
HOLD_PORT=8999
# 10_run_policy.sh がつなぐ先. 別の PC で方策サーバを動かすときは、その PC の IP アドレスにする
# （例: INFER_HOST=192.168.1.20:8999）
INFER_HOST=127.0.0.1:8999
